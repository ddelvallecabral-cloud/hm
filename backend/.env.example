# Copiar a backend/.env (desarrollo). En producción definir en el entorno / gestor de secretos.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Administrador inicial (lo crea docker compose al arrancar, si no existe)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=cambiar-esta-clave
DJANGO_SUPERUSER_EMAIL=

# PostgreSQL
POSTGRES_DB=tesoreria
POSTGRES_USER=tesoreria
POSTGRES_PASSWORD=tesoreria
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Frontend (CORS/CSRF)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Dominio
CRM_MONEDA_BASE=PYG
# true = exigir N° de OC a profesionales y pymes (por defecto es opcional)
CRM_EXIGIR_OC=false
# Intereses por mora: tope mensual en USD (%), usar el tope BCP si la factura no pactó tasa,
# y usar la última tasa BCP cargada si falta la del mes de vencimiento (con alerta)
CRM_TOPE_MENSUAL_USD=1.00
CRM_USAR_TASA_BCP_SIN_PACTO=true
CRM_PERMITIR_TASA_MES_ANTERIOR=true
EMPRESA_RUC=80013339-0
EMPRESA_TIMBRADO=


# Correo (sólo prod)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
