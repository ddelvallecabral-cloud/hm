# Copiar a backend/.env (desarrollo). En producción definir en el entorno / gestor de secretos.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DB=tesoreria
POSTGRES_USER=tesoreria
POSTGRES_PASSWORD=tesoreria
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Frontend (CORS/CSRF)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Dominio
CRM_MONEDA_BASE=PYG
# true = exigir N° de OC a profesionales y pymes (por defecto es opcional)
CRM_EXIGIR_OC=false
EMPRESA_RUC=
EMPRESA_TIMBRADO=

# SIFEN (SET) - completar al integrar facturación electrónica
SIFEN_AMBIENTE=test
SIFEN_URL_WS=
SIFEN_CERT_PATH=
SIFEN_CERT_PASSWORD=
SIFEN_ID_CSC=
SIFEN_CSC=

# Correo (sólo prod)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
